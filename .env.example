# ============================================================
# EdgeRover Configuration Template (.env.example)
# Copy this file to .env and insert your real keys
# ============================================================

# Groq Cloud API Key (Tier 1 Strategic Brain)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Selection
GROQ_MODEL=openai/gpt-oss-120b

# Telegram Bot Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cactus Needle SLM Telemetry
NEEDLE_TELEMETRY=0
